# ========================================
# Server Configuration
# ========================================
PORT=3001
NODE_ENV=development

# ========================================
# OpenAI API (REQUIRED)
# ========================================
# Used for: Conversation Service, Grammar Service, Dialogue Generator
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google Genkit (Optional - Fallback/Alternative)
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Tavily Search API (Required for Real-time Cultural Context)
TAVILY_API_KEY=tv-your_tavily_api_key_here

# ========================================
# TTS (Text-to-Speech) Services
# ========================================
# Configure at least one TTS provider below
# Priority order: AWS Polly > ElevenLabs > Google Cloud > Web Speech API (fallback)

# AWS Polly Configuration (High Quality TTS - Recommended)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# ElevenLabs API Key (Premium Voice Quality)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Cloud TTS Configuration
# Option 1: Use service account key file (recommended for production)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Option 2: Use API Key (simpler for development)
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Option 3: Use inline credentials (alternative)
# GOOGLE_CLOUD_PROJECT_ID=your-project-id
# GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CLOUD_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# ========================================
# Frontend Configuration (Vite)
# ========================================
# Firebase Configuration (REQUIRED for Frontend Auth/Firestore)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Sentry Integration (Optional - for error tracking)
VITE_ENABLE_SENTRY=false
VITE_SENTRY_DSN=your_sentry_dsn_here

# ========================================
# CI/CD Configuration (Optional)
# ========================================
# Set to true in CI environments for stricter test behavior
# CI=true
# ========================================
# Script Configuration (Internal Use)
# ========================================
# Used for: backend/scripts/seedLessons.js
ADMIN_EMAIL=admin@apptutor.test
ADMIN_PASSWORD=adminPassword123!
